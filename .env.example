# Скопируй этот файл в .env и впиши реальные значения.
# .env НЕ коммитится и НЕ шарится никому (см. .gitignore).

# Новый токен от @BotFather (старый, засвеченный в чате, отзови через /revoke).
BOT_TOKEN=PASTE_NEW_TOKEN_FROM_BOTFATHER

# Твой числовой Telegram ID (узнать: напиши боту /me в ЛС). Можно несколько через запятую.
ADMIN_IDS=123456789
